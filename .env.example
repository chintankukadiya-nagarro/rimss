# Docker Compose loads this when you use: compose:up script (Docker env)
POSTGRES_USER=rimss
POSTGRES_PASSWORD=rimss
POSTGRES_DB=rimss

# API (apps/api reads from .env in rimss-demo root or copy to apps/api/.env)
DATABASE_URL=postgresql://rimss:rimss@localhost:5433/rimss
REDIS_URL=redis://localhost:6380
API_PORT=4000
# Payment (Phase 3) — default mock; no Stripe keys required
PAYMENT_PROVIDER=mock
# Uncomment for real Stripe test mode:
# PAYMENT_PROVIDER=stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Default OfferZone palette: stone | ocean (overridable with ?theme= on /)
# NEXT_PUBLIC_STORE_THEME=ocean
NEXT_PUBLIC_API_URL=http://localhost:4000
# Same-origin /api rewrite target in next.config (cart cookies in dev)
API_PROXY_ORIGIN=http://127.0.0.1:4000
